# =============================================================================
# OpenVPN - Configuração do Cliente
# Distribuir este arquivo para cada usuário
# Substituir <GATEWAY_IP> pelo IP público/acessível do servidor
# =============================================================================

client
dev tun
proto udp

# Endereço do servidor OpenVPN (ajustar para o IP/FQDN do gateway)
remote 177.8.81.162 443

# Tenta reconectar indefinidamente
resolv-retry infinite
nobind

# Autenticação LDAP: solicita usuário e senha ao conectar
# O usuário deve informar seu CN do diretório LDAP (dc=cige,dc=eb,dc=mil,dc=br)
auth-user-pass

# Persistência de conexão
persist-key
persist-tun

# =============================================================================
# CRIPTOGRAFIA (deve espelhar o servidor)
# =============================================================================
# Certificados serão incorporados no arquivo .ovpn
# Não é necessário arquivos separados quando usando .ovpn com certificados embarcados

data-ciphers AES-256-GCM:AES-128-GCM:AES-256-CBC
data-ciphers-fallback AES-256-CBC

# Verificação do certificado do servidor
remote-cert-tls server

# Compressão LZO (compatível com servidor)
compress lzo
allow-compression yes

# =============================================================================
# PERFORMANCE E ESTABILIDADE
# =============================================================================
# Keepalive
keepalive 10 60


# Buffer de socket (0 = usa padrão do SO, otimizado via sysctl)
sndbuf 0
rcvbuf 0

# Reconexão em caso de queda
connect-retry 5
connect-retry-max 10

# =============================================================================
# LOGGING
# =============================================================================
verb 3
mute 10

